{:paths ["src"]

 :deps {org.clojure/data.json
        {:git/url "https://github.com/clojure/data.json.git"
         :git/sha "1fce9070ee851f49a6c4ce6e1c0bb0db4d7594a0"}
        ;; data.json reads java.time.format.DateTimeFormatter/ISO_INSTANT at
        ;; namespace-load time, and java.time.* is this library (jolt-lang/time)
        ;; rather than core, so jolt.time must load first — see the ns form.
        io.github.jolt-lang/time
        {:git/url "https://github.com/jolt-lang/time.git"
         :git/sha "2c58d9c709a25d80608757c3026f4c656a994ef1"}
        ;; reagent-style reactive cells: the SSE live-render loop subscribes to
        ;; every ratom the page render derefs and re-renders when it changes.
        jolt-lang/glimmer
        {:git/url "https://github.com/jolt-lang/glimmer"
         :git/tag "v0.1.6"
         :git/sha "d81af8fb2fa4164a2261db3c15fc7c93271dce60"}}

 :aliases {:test {:extra-paths ["test"]
                 :main-opts   ["-m" "jolt.datastar.core-test"]}}

 :tasks {test "jolt -M:test"}}
